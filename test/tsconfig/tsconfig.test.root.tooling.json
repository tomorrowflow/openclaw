{
  "extends": "./tsconfig.test.root.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/test-root-tooling.tsbuildinfo"
  },
  "include": [
    "../../test/scripts/ci-*.ts",
    "../../test/scripts/ci-*.tsx",
    "../../test/scripts/check-*.ts",
    "../../test/scripts/check-*.tsx",
    "../../test/scripts/pr-*.ts",
    "../../test/scripts/pr-*.tsx",
    "../../test/scripts/release-*.ts",
    "../../test/scripts/release-*.tsx",
    "../../test/scripts/vitest-*.ts",
    "../../test/scripts/vitest-*.tsx",
    "../../test/**/*.d.ts",
    "../../test/**/*.d.mts",
    "../../test/**/*.d.cts",
    "../../src/**/*.d.ts",
    "../../packages/**/*.d.ts",
    "../../ui/**/*.d.ts"
  ],
  // These import .github/actions files the fork removes on every sync.
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../test/fixtures/**",
    // These Docker E2E clients statically import built dist/** artifacts and are
    // validated by their Docker lanes, so they cannot join this source-only program
    // (same rationale as the scripts/e2e exclusion in tsconfig.scripts.json).
    "../../test/e2e/qa-lab/runtime/system-agent-first-run-docker-client.ts",
    "../../test/e2e/qa-lab/runtime/agent-bundle-mcp-tools-docker-client.ts",
    "../../test/scripts/ci-changed-node-test-plan.process-owners.test.ts",
    "../../test/scripts/ci-changed-node-test-plan.test.ts",
    "../../test/scripts/ci-git-prerequisites.test.ts"
  ]
}
